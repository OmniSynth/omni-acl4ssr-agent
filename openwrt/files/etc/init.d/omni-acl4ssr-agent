#!/bin/sh /etc/rc.common
# Copyright (C) 2026 omni-acl4ssr-agent

START=99
STOP=10
USE_PROCD=1

NAME=omni-acl4ssr-agent
PROG=/usr/bin/omni-acl4ssr-agent
CONF_DIR=/etc/omni-acl4ssr-agent
WEB_DIR=/usr/share/omni-acl4ssr-agent/web

start_service() {
	local enabled listen tls_listen

	config_load omni_acl4ssr_agent
	config_get_bool enabled config enabled 1
	config_get listen config listen '0.0.0.0:8787'
	config_get tls_listen config tls_listen '0.0.0.0:8788'

	[ "$enabled" = "1" ] || return 0
	[ -x "$PROG" ] || {
		echo "$PROG not found"
		return 1
	}

	mkdir -p "$CONF_DIR"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env OMNI_DATA_DIR="$CONF_DIR" OMNI_LISTEN="$listen" OMNI_TLS_LISTEN="$tls_listen" OMNI_WEB_DIR="$WEB_DIR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "omni_acl4ssr_agent"
}

reload_service() {
	stop
	start
}
